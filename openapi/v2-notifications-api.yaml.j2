  /v2/manage-template/template-categories:
    get:
      summary: {{ t("Get template categories") }}
      description: |
        {{ t("Retrieve all available template categories for manage template operations.") }}

        {{ t("This endpoint requires a NEW API key with the manage_templates permission.") }}
      operationId: getManageTemplateCategories
      tags:
        - Manage Templates
      responses:
        '200':
          description: {{ t("Template categories retrieved successfully") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ManageTemplateCategoriesResponse'
        '401':
          description: {{ t("Unauthorized") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
              example:
                auth_error:
                  summary: Unauthorized access
                  value:
                    status_code: 401
                    errors:
                      - error: "AuthError"
                        message: "Unauthorized, authentication token must be provided"
        '403':
          description: {{ t("Forbidden - NEW API key missing required manage_templates permission") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
              examples:
                missing_permission:
                  summary: {{ t("Missing manage templates permission") }}
                  value:
                    status_code: 403
                    errors:
                      - error: "ForbiddenError"
                        message: "This API key does not have permission to manage templates."
        '500':
          description: {{ t("Internal server error") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
      security:
        - apiKey: []


  /v2/manage-template/{template-id}:
    get:
      summary: {{ t("Get template by ID") }}
      description: |
        {{ t("Retrieve a specific template by ID using manage template permissions.") }}

        {{ t("This endpoint requires a NEW API key with the manage_templates permission.") }}
      operationId: getManageTemplateById
      tags:
        - Manage Templates
      parameters:
        - name: template-id
          in: path
          description: {{ t("Unique identifier for the template") }}
          required: true
          schema:
            $ref: '#/components/schemas/UUID'
      responses:
        '200':
          description: {{ t("Template retrieved successfully") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ManageTemplate'
        '400':
          description: {{ t("Bad request - invalid template ID format") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
              example:
                status_code: 400
                errors:
                  - error: "ValidationError"
                    message: "id is not a valid UUID"
        '401':
          description: {{ t("Unauthorized") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
        '403':
          description: {{ t("Forbidden - NEW API key missing required manage_templates permission") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
              examples:
                missing_permission:
                  summary: {{ t("Missing manage templates permission") }}
                  value:
                    status_code: 403
                    errors:
                      - error: "ForbiddenError"
                        message: "This API key does not have permission to manage templates."
        '404':
          description: {{ t("Template not found") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
              example:
                template_not_found:
                  summary: Template not found
                  value:
                    status_code: 404
                    errors:
                      - error: "TemplateNotFoundError"
                        message: "Template not found in database"
        '500':
          description: {{ t("Internal server error") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
      security:
        - apiKey: []

    patch:
      summary: {{ t("Update a template") }}
      description: |
        {{ t("Update editable fields on a template, including category and parent folder assignment.") }}

        {{ t("This endpoint requires a NEW API key with the manage_templates permission.") }}
      operationId: patchManageTemplate
      tags:
        - Manage Templates
      parameters:
        - name: template-id
          in: path
          description: {{ t("Unique identifier for the template") }}
          required: true
          schema:
            $ref: '#/components/schemas/UUID'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ManageTemplatePatchRequest'
            examples:
              update_name_and_category:
                summary: {{ t("Update template name and category") }}
                value:
                  name: "{{ t("Follow-up reminder") }}"
                  template_category_id: "12345678-1234-1234-1234-123456789012"
              move_template_to_folder:
                summary: {{ t("Move template into a folder") }}
                value:
                  parent_folder_id: "87654321-4321-4321-4321-210987654321"
              remove_from_folder:
                summary: {{ t("Remove template from folder") }}
                value:
                  parent_folder_id: null
      responses:
        '200':
          description: {{ t("Template updated successfully") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ManageTemplate'
        '400':
          description: {{ t("Bad request - validation or category errors") }}
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: '#/components/schemas/ValidationErrorResponse'
                  - $ref: '#/components/schemas/ManageTemplateCategoryErrorResponse'
              examples:
                invalid_template_id:
                  summary: {{ t("Invalid template ID format") }}
                  value:
                    status_code: 400
                    errors:
                      - error: "ValidationError"
                        message: "id is not a valid UUID"
                invalid_parent_folder:
                  summary: {{ t("Parent folder not found") }}
                  value:
                    status_code: 400
                    errors:
                      - error: "BadRequestError"
                        message: "parent_folder_id not found"
                category_not_found:
                  summary: {{ t("Template category not found") }}
                  value:
                    status_code: 400
                    errors:
                      - error: "TemplateCategoryNotFoundError"
                        message: "template_category_id not found"
                    template_categories:
                      - template_category_id: "12345678-1234-1234-1234-123456789012"
                        name: "{{ t("Updates") }}"
                category_invalid:
                  summary: {{ t("Invalid template category value") }}
                  value:
                    status_code: 400
                    errors:
                      - error: "TemplateCategoryValidationError"
                        message: "template_category_id must be a valid UUID"
                    template_categories:
                      - template_category_id: "12345678-1234-1234-1234-123456789012"
                        name: "{{ t("Updates") }}"
        '401':
          description: {{ t("Unauthorized") }}
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
        '403':
          description: {{ t("Forbidden - NEW API key missing required manage_templates permission") }}
          content:
            application/json:
